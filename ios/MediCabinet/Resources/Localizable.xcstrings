{
  "sourceLanguage": "fr",
  "strings": {
    "about.disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MediCabinet is an inventory tool. It gives no medical advice: for any question about a medicine, ask a pharmacist or a doctor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MediCabinet est un outil d'inventaire. Il ne donne aucun conseil médical : pour toute question sur un médicament, demandez conseil à un pharmacien ou à un médecin."
          }
        }
      }
    },
    "about.reference.date": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data as of %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données du %1$@"
          }
        }
      }
    },
    "about.reference.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading reference data…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement des données de référence…"
          }
        }
      }
    },
    "about.reference.notEndorsed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MediCabinet is not affiliated with or endorsed by ANSM, HAS or the French national health insurance. Categories are suggested by MediCabinet to tidy the cabinet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MediCabinet n'est ni affilié ni approuvé par l'ANSM, la HAS ou l'Assurance Maladie. Les catégories sont proposées par MediCabinet pour ranger l'armoire."
          }
        }
      }
    },
    "about.reference.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the database website"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le site de la base de données"
          }
        }
      }
    },
    "about.reference.source": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source: Base de Données Publique des Médicaments"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Source : Base de Données Publique des Médicaments"
          }
        }
      }
    },
    "about.reference.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference data"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de référence"
          }
        }
      }
    },
    "about.reference.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference data unavailable: scanned products will need to be named by hand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de référence indisponibles : les produits scannés devront être nommés à la main."
          }
        }
      }
    },
    "about.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ (%2$@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ (%2$@)"
          }
        }
      }
    },
    "bootstrap.error.backup.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before updating your data, MediCabinet must make a copy of it, but the copy could not be written (is storage full?). Your data has not been changed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de mettre à jour vos données, MediCabinet doit en faire une copie, mais elle n'a pas pu être écrite (espace insuffisant ?). Vos données n'ont pas été modifiées."
          }
        }
      }
    },
    "bootstrap.error.backup.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup failed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde impossible"
          }
        }
      }
    },
    "bootstrap.error.migration.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data could not be updated. It has been put back as it was: nothing is lost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données n'ont pas pu être mises à jour. Elles ont été remises dans leur état précédent : rien n'est perdu."
          }
        }
      }
    },
    "bootstrap.error.migration.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update failed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour impossible"
          }
        }
      }
    },
    "bootstrap.error.storage.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MediCabinet cannot access its storage (is storage full?). Your data has not been changed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MediCabinet ne peut pas accéder à son espace de stockage (espace insuffisant ?). Vos données n'ont pas été modifiées."
          }
        }
      }
    },
    "bootstrap.error.storage.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage unavailable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockage inaccessible"
          }
        }
