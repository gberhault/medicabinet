<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The camera, requested at runtime when the user opens the scanner; the app stays usable (manual entry)
         without it. No network request (see docs/architecture.md). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- The monthly reminder (Android 13+ asks at runtime, only when the user turns the reminder on; older versions
         have no permission). Never an exact-alarm permission: the digest uses an inexact alarm. RECEIVE_BOOT_COMPLETED
         arms that alarm again after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- camera-view pulls in media3-common, which declares this permission for video playback we do not use. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".MediCabinetApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediCabinet">
        <!-- singleTop: a notification tap or a file opened while the app is shown reaches onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open with (design §7.3): never ordinary JSON, never every file. Files this app wrote or shared carry
                 its MIME type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/vnd.medicabinet+json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.medicabinet+json" />
            </intent-filter>
            <!-- Files come back as octet-stream: a saved file, and the copy another app (WhatsApp, Mail, a file manager)
                 opens through its own provider, whose address has no file name or extension and whose type it derived
                 itself. A filter cannot see the display name, so there is NO host and NO path restriction: MediCabinet
                 may be offered for any unknown binary file. Safe because only content addresses are read and the import
                 refuses anything that is not a cabinet before changing anything (design §7.3, O2). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Hands one shared archive (cache/export/ only) to the app the user picked in the share sheet, with a
             one-time read grant. Not exported: no other app can open it by itself. The authority follows the
             applicationId so the side-by-side perf build can be installed too. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>

        <!-- The digest alarm. No intent filter: only this app's own PendingIntent reaches it. -->
        <receiver
            android:name=".reminders.DigestAlarmReceiver"
            android:exported="false" />

        <!-- Arms the alarm again after a reboot, an app update, a time-zone change or a clock change. These are
             system broadcasts, which reach a receiver that is not exported. -->
        <receiver
            android:name=".reminders.RescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
