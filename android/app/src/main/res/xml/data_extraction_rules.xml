<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device transfer: same content as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="cabinet.db" />
        <include domain="database" path="cabinet.db-wal" />
        <include domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="cabinet.db" />
        <include domain="database" path="cabinet.db-wal" />
        <include domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
