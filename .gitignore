# macOS
.DS_Store

# Xcode (project is generated by XcodeGen from project.yml)
*.xcodeproj/
*.xcworkspace/
!Packages/**/*.xcworkspace/
xcuserdata/
DerivedData/
build/
*.xcresult
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# Local signing (copy Config/Signing.local.xcconfig.sample)
Config/Signing.local.xcconfig

# Generated reports (see CLAUDE.md → Reporting)
reports/**/*.html
coverage/

# Raw reference datasets downloaded by scripts/build-reference-db.sh
scripts/.cache/

# Secrets
.env
