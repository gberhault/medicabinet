{
  "formatVersion": 2,
  "description": "ProductResolver.resolve(reference, named, previousBox). reference: the reference-data product (name, optional category) or null; named: the named product of the code (name, category, categoryOverridden) or null; previousBox: the most recent non-deleted box with the same GTIN or null. expect.name null = unknown product (the app asks for a name). For a code the reference knows: the name is the reference name; the category is the previous box's when the user set it (categoryOverridden), else the reference category, else uncategorized; named is ignored. For a code the reference does not know: the name is the named product's (null when there is none) and the category is the named product's when categoryOverridden, else uncategorized; the previous box is ignored (#57).",
  "cases": [
    {
      "name": "nothing known",
      "reference": null,
      "named": null,
      "previousBox": null,
      "expect": {
        "name": null,
        "category": "uncategorized",
        "categoryOverridden": false
      }
    },
    {
      "name": "reference only, no category",
      "reference": {
        "name": "DOLIPRANE 1000 mg",
        "category": null
      },
      "named": null,
      "previousBox": null,
      "expect": {
        "name": "DOLIPRANE 1000 mg",
        "category": "uncategorized",
        "categoryOverridden": false
      }
    },
    {
      "name": "reference only, with category",
      "reference": {
        "name": "DOLIPRANE 1000 mg",
        "category": "pain-fever"
      },
      "named": null,
      "previousBox": null,
      "expect": {
        "name": "DOLIPRANE 1000 mg",
        "category": "pain-fever",
        "categoryOverridden": false
      }
    },
    {
      "name": "a previous box no longer names a code the reference does not know (#57)",
      "reference": null,
      "named": null,
      "previousBox": {
        "name": "Test name",
        "category": "cold-ent",
        "categoryOverridden": true
      },
      "expect": {
        "name": null,
        "category": "uncategorized",
        "categoryOverridden": false
      }
    },
    {
      "name": "a previous box with an automatic category is ignored too",
      "reference": null,
      "named": null,
      "previousBox": {
        "name": "Doliprane",
        "category": "pain-fever",
        "categoryOverridden": false
      },
      "expect": {
        "name": null,
        "category": "uncategorized",
        "categoryOverridden": false
      }
    },
    {
      "name": "reference name wins over the previous box name",
      "reference": {
        "name": "DOLIPRANE 1000 mg",
        "category": null
      },
      "named": null,
      "previousBox": {
        "name": "Doliprane",
        "category": "uncategorized",
        "categoryOverridden": false
      },
      "expect": {
        "name": "DOLIPRANE 1000 mg",
        "category": "uncategorized",
        "categoryOverridden": false
      }
    },
    {
      "name": "user category of the previous box wins over the reference category",
      "reference": {
        "name": "DOLIPRANE 1000 mg",
        "category": "pain-fever"
      },
      "named": null,
      "previousBox": {
        "name": "Doliprane",
        "category": "skin-wound",
        "categoryOverridden": true
      },
      "expect": {
        "name": "DOLIPRANE 1000 mg",
        "category": "skin-wound",
        "categoryOverridden": true
      }
    },
    {
      "name": "reference category wins over an automatic previous category",
      "reference": {
        "name": "DOLIPRANE 1000 mg",
        "category": "pain-fever"
      },
      "named": null,
      "previousBox": {
        "name": "Doliprane",
        "category": "digestion",
        "categoryOverridden": false
      },
      "expect": {
        "name": "DOLIPRANE 1000 mg",
        "category": "pain-fever",
        "categoryOverridden": false
      }
    },
    {
      "name": "named product only, category set by the user",
      "reference": null,
      "named": {
        "name": "Thermomètre",
        "category": "other",
        "categoryOverridden": true
      },
      "previousBox": null,
      "expect": {
        "name": "Thermomètre",
        "category": "other",
        "categoryOverridden": true
      }
    },
    {
      "name": "named product only, category not set by the user",
      "reference": null,
      "named": {
        "name": "Crème solaire",
        "category": "digestion",
        "categoryOverridden": false
      },
      "previousBox": null,
      "expect": {
        "name": "Crème solaire",
        "category": "uncategorized",
        "categoryOverridden": false
      }
    },
    {
      "name": "named product with a user category that is uncategorized",
      "reference": null,
      "named": {
        "name": "Pansements",
        "category": "uncategorized",
        "categoryOverridden": true
      },
      "previousBox": null,
      "expect": {
        "name": "Pansements",
        "category": "uncategorized",
        "categoryOverridden": true
      }
    },
    {
      "name": "named product wins over a previous box of an unknown code",
      "reference": null,
      "named": {
        "name": "Crème solaire",
        "category": "skin-wound",
        "categoryOverridden": true
      },
      "previousBox": {
        "name": "Test name",
        "category": "other",
        "categoryOverridden": true
      },
      "expect": {
        "name": "Crème solaire",
        "category": "skin-wound",
        "categoryOverridden": true
      }
    },
    {
      "name": "reference name wins over a named product",
      "reference": {
        "name": "DOLIPRANE 1000 mg",
        "category": "pain-fever"
      },
      "named": {
        "name": "Mon Doliprane",
        "category": "other",
        "categoryOverridden": true
      },
      "previousBox": null,
      "expect": {
        "name": "DOLIPRANE 1000 mg",
        "category": "pain-fever",
        "categoryOverridden": false
      }
    },
    {
      "name": "a named product is ignored for a known code, the previous box category still applies",
      "reference": {
        "name": "DOLIPRANE 1000 mg",
        "category": "pain-fever"
      },
      "named": {
        "name": "Mon Doliprane",
        "category": "other",
        "categoryOverridden": true
      },
      "previousBox": {
        "name": "Doliprane",
        "category": "skin-wound",
        "categoryOverridden": true
      },
      "expect": {
        "name": "DOLIPRANE 1000 mg",
        "category": "skin-wound",
        "categoryOverridden": true
      }
    }
  ]
}
