        "hasSerial": true,
        "expiry": "invalid"
      },
      "productKnown": false,
      "cabinetMatch": null,
      "sessionHasGTIN": false,
      "expect": {
        "decision": "complete",
        "missing": [
          "name",
          "expiry"
        ],
        "expiryUnreadable": true
      }
    },
    {
      "name": "serial new, product seen earlier in the session: still added (no 'another box?')",
