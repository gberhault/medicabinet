        "hasSerial": true,
        "expiry": "known"
      },
      "productKnown": true,
      "cabinetMatch": null,
      "sessionHasGTIN": true,
      "expect": {
        "decision": "add"
      }
    },
    {
      "name": "serial new, product seen earlier, expiry missing: completion, not confirmation",
