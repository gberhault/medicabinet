{
  "formatVersion": 1,
  "description": "IntakePolicy.decide. scan.hasSerial: the code carries a serial; scan.expiry: known | missing | invalid (what the code says). productKnown: the name is already resolved (reference data or a product the household named). cabinetMatch: null | inCabinet | removed — a non-deleted box with the same GTIN and serial (only meaningful when hasSerial). sessionHasGTIN: a box with this GTIN was already added in the current scan session. expect.decision: add | complete | confirmAnother | alreadyInCabinet | removedEarlier. complete carries missing (name and/or expiry) and expiryUnreadable; confirmAnother carries thenMissing and expiryUnreadable, to be asked after the user confirms. expiryUnreadable is true when the code held an invalid date.",
  "cases": [
    {
      "name": "serial, no match, expiry known, product known",
      "scan": {
        "hasSerial": true,
        "expiry": "known"
      },
      "productKnown": true,
      "cabinetMatch": null,
      "sessionHasGTIN": false,
      "expect": {
        "decision": "add"
      }
    },
    {
      "name": "serial, no match, expiry known, product unknown",
      "scan": {
        "hasSerial": true,
        "expiry": "known"
      },
      "productKnown": false,
      "cabinetMatch": null,
      "sessionHasGTIN": false,
      "expect": {
        "decision": "complete",
        "missing": [
          "name"
        ],
        "expiryUnreadable": false
      }
    },
    {
      "name": "serial, no match, expiry missing, product known",
      "scan": {
        "hasSerial": true,
        "expiry": "missing"
      },
      "productKnown": true,
      "cabinetMatch": null,
      "sessionHasGTIN": false,
      "expect": {
        "decision": "complete",
        "missing": [
          "expiry"
        ],
        "expiryUnreadable": false
      }
    },
    {
      "name": "serial, no match, expiry missing, product unknown",
      "scan": {
        "hasSerial": true,
        "expiry": "missing"
      },
      "productKnown": false,
      "cabinetMatch": null,
      "sessionHasGTIN": false,
      "expect": {
        "decision": "complete",
        "missing": [
          "name",
          "expiry"
        ],
        "expiryUnreadable": false
      }
    },
    {
      "name": "serial, no match, expiry invalid, product known",
      "scan": {
        "hasSerial": true,
        "expiry": "invalid"
      },
      "productKnown": true,
      "cabinetMatch": null,
      "sessionHasGTIN": false,
      "expect": {
        "decision": "complete",
        "missing": [
          "expiry"
        ],
        "expiryUnreadable": true
      }
    },
    {
      "name": "serial, no match, expiry invalid, product unknown",
