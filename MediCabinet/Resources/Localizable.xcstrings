{
  "sourceLanguage": "fr",
  "strings": {
    "about.disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MediCabinet is an inventory tool. It gives no medical advice: for any question about a medicine, ask a pharmacist or a doctor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MediCabinet est un outil d'inventaire. Il ne donne aucun conseil médical : pour toute question sur un médicament, demandez conseil à un pharmacien ou à un médecin."
          }
        }
      }
    },
    "about.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ (%2$@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ (%2$@)"
          }
        }
      }
    },
    "bootstrap.error.backup.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before updating your data, MediCabinet must make a copy of it, but the copy could not be written (is storage full?). Your data has not been changed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de mettre à jour vos données, MediCabinet doit en faire une copie, mais elle n'a pas pu être écrite (espace insuffisant ?). Vos données n'ont pas été modifiées."
          }
        }
      }
    },
    "bootstrap.error.backup.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup failed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde impossible"
          }
        }
      }
    },
    "bootstrap.error.migration.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data could not be updated. It has been put back as it was: nothing is lost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données n'ont pas pu être mises à jour. Elles ont été remises dans leur état précédent : rien n'est perdu."
          }
        }
      }
    },
    "bootstrap.error.migration.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update failed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour impossible"
          }
        }
      }
    },
    "bootstrap.error.storage.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MediCabinet cannot access its storage (is storage full?). Your data has not been changed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MediCabinet ne peut pas accéder à son espace de stockage (espace insuffisant ?). Vos données n'ont pas été modifiées."
          }
        }
      }
    },
    "bootstrap.error.storage.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage unavailable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockage inaccessible"
          }
        }
      }
    },
    "bootstrap.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening your cabinet…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouverture de l'armoire…"
          }
        }
      }
    },
    "bootstrap.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        }
      }
    },
    "location.default.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicine cabinet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Armoire à pharmacie"
          }
        }
      }
    },
    "placeholder.cabinet.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your medicines, sorted by category and location, will appear here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos médicaments, classés par catégorie et par lieu, apparaîtront ici."
          }
        }
      }
    },
    "placeholder.cabinet.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cabinet is coming soon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'armoire arrive bientôt"
          }
        }
      }
    },
    "placeholder.expiring.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expired and soon-to-expire medicines will be listed here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les médicaments périmés ou bientôt périmés seront listés ici."
          }
        }
      }
    },
    "placeholder.expiring.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expiry tracking is coming soon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi des péremptions arrive bientôt"
          }
        }
      }
    },
    "placeholder.scan.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soon you will be able to scan your medicine boxes one after the other."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez bientôt scanner vos boîtes de médicaments les unes après les autres."
          }
        }
      }
    },
    "placeholder.scan.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning is coming soon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scan arrive bientôt"
          }
        }
      }
    },
